<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Reactor.Cli</RootNamespace>
    <AssemblyName>reactor</AssemblyName>
    <Description>reactor: command-line runner for Reactor pipelines.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>reactor</ToolCommandName>
    <PackageId>Reactor.Cli</PackageId>
    <!-- The bundled Copilot runtime contains dotfiles (e.g. plugins/*/.release-target) that must ship with it. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <!-- Direct reference so the Copilot runtime is bundled with the CLI (the SDK's build assets are not transitive). -->
    <PackageReference Include="GitHub.Copilot.SDK" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Reactor.Cli.Tests" />
  </ItemGroup>

  <!--
    The GitHub Copilot CLI license lets an application redistribute the runtime only together with a copy of that
    license. The SDK leaves the downloaded release's LICENSE.md behind, so ship it next to the runtime.
  -->
  <Target Name="ShipCopilotCliLicense" AfterTargets="_RegisterCopilotCliForCopy" Condition="'$(CopilotSkipCliDownload)' != 'true' and '$(CopilotCliBinaryPath)' == '' and '$(_CopilotRid)' != ''">
    <PropertyGroup>
      <_CopilotCliLicense>$(_CopilotCacheDir)\LICENSE.md</_CopilotCliLicense>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CopilotCliLicense)')" Text="The GitHub Copilot CLI license was not found at '$(_CopilotCliLicense)'. The bundled runtime must not ship without it." />
    <ItemGroup>
      <ContentWithTargetPath Include="$(_CopilotCliLicense)" TargetPath="runtimes\$(_CopilotRid)\native\LICENSE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Reactor\Reactor.csproj" />
    <ProjectReference Include="..\Reactor.Llm\Reactor.Llm.csproj" />
    <ProjectReference Include="..\Reactor.Agent\Reactor.Agent.csproj" />
    <ProjectReference Include="..\Reactor.Backends\Reactor.Backends.csproj" />
    <ProjectReference Include="..\Reactor.Copilot\Reactor.Copilot.csproj" />
    <ProjectReference Include="..\Reactor.Server\Reactor.Server.csproj" />
  </ItemGroup>
</Project>