<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Reactor.Server</RootNamespace>
    <Description>HTTP server mode for Reactor: REST API, server-sent events, and a web console for human-in-the-loop gates.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reactor\Reactor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="Reactor.Server.wwwroot.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Reactor.Server.Tests" />
  </ItemGroup>
</Project>