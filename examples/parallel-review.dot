// Fan-out / fan-in: three independent reviews run concurrently in isolated contexts, then a
// fan-in node gathers the results (parallel.results) for a final summary.
digraph parallel_review {
    graph [goal="Review the code in this repository"]

    start [shape=Mdiamond]
    exit  [shape=Msquare]

    reviews   [shape=component, label="Parallel reviews", join_policy="wait_all", max_parallel=3]
    security  [prompt="Review this repository for security problems. List concrete findings with file names."]
    perf      [prompt="Review this repository for performance problems. List concrete findings with file names."]
    style     [prompt="Review this repository for readability and maintainability problems."]
    gather    [shape=tripleoctagon, label="Gather reviews"]
    summarize [prompt="Combine the three reviews in context (parallel.results) into one prioritized list.", fidelity="full"]

    start -> reviews
    reviews -> security
    reviews -> perf
    reviews -> style
    security -> gather
    perf -> gather
    style -> gather
    gather -> summarize -> exit
}
