// Model stylesheet: CSS-like rules assign models per node. Specificity: * < .class < #id; explicit
// node attributes always win. Subgraph labels become classes ("Deep thinking" -> .deep-thinking).
// Model ids must exist for your backend: `reactor models --provider copilot` lists the Copilot ones.
digraph stylesheet_demo {
    graph [
        goal="Design and implement a small CLI todo app in Python",
        model_stylesheet="
            * { llm_model: gpt-5-mini; reasoning_effort: medium; }
            .deep-thinking { llm_model: claude-sonnet-5; reasoning_effort: high; }
            #final_review { llm_model: gpt-5.5; }
        "
    ]

    start [shape=Mdiamond]
    exit  [shape=Msquare]

    subgraph cluster_design {
        label="Deep thinking"
        architecture [prompt="Design the architecture for: $goal. Write DESIGN.md."]
    }

    implement    [prompt="Implement the design in DESIGN.md."]
    write_tests  [prompt="Write tests for the implementation."]
    final_review [prompt="Review the implementation against DESIGN.md and fix any gaps."]

    start -> architecture -> implement -> write_tests -> final_review -> exit
}
